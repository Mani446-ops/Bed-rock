# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Amazon Bedrock
BEDROCK_MODEL_ID=your-bedrock-model-id
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon SageMaker
SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name

# Application Configuration
APP_NAME=banking-agentic-ai
APP_ENV=development
LOG_LEVEL=INFO

# Vector Database
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=data/vector_store/faiss_index

# LLM Configuration
TEMPERATURE=0.2
MAX_TOKENS=2048